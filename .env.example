# Copy this file to .env and fill in your own values.
# Get the MongoDB connection string from MongoDB Atlas > Connect > Drivers.
MONGO_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=healthcare_management
SECRET_KEY=replace-with-a-long-random-secret
